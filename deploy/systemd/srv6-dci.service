# srv6-dci as a host service next to FRR (e.g. on a metal-stack firewall).
# Install: binary to /usr/local/bin, config to /etc/srv6-dci/config.yaml, then
#   systemctl daemon-reload && systemctl enable --now srv6-dci
[Unit]
Description=srv6-dci: stitch EVPN tenant VRFs via SRv6 L3VPN
Documentation=https://github.com/mwindower/srv6-dci
# srv6-dci talks to FRR via vtysh and retries until FRR is up; it re-applies
# its configuration whenever the base system reloads FRR.
After=network-online.target frr.service
Wants=network-online.target frr.service

[Service]
ExecStart=/usr/local/bin/srv6-dci run -c /etc/srv6-dci/config.yaml
Restart=always
RestartSec=5
StateDirectory=srv6-dci

[Install]
WantedBy=multi-user.target
